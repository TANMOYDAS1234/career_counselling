# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# The Python backend lives here locally but is version-controlled in its own
# repo (Career_counselling-_backend) and deployed on Render — keep it out of the
# app repo so CI builds only the Flutter app.
/backend/

# Secrets — never commit
*.env
.env

# GitHub Actions workflow needs a token with `workflow` scope to push; add it via
# the GitHub UI instead. (Codemagic's codemagic.yaml is committed and is the main CI.)
/.github/workflows/build.yml
